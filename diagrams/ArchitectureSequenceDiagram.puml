@startuml
!include style.puml
skinparam ArrowFontStyle plain
actor User as user USER_COLOR
participant ":UI" as ui UI_COLOR
participant ":Logic" as logic LOGIC_COLOR
participant "live:Model" as live MODEL_COLOR
participant "candidate:Model" as candidate MODEL_COLOR
participant ":Storage" as storage STORAGE_COLOR

title Successful member deletion
user -> ui : member delete nus/A0123456X
activate ui
ui -> logic : execute("member delete nus/A0123456X")
activate logic
note over logic
  Parse through the member family and delete leaf parser.
  The member exists, is active and holds no open loans.
end note
logic -> live : createTransactionSnapshot()
live --> logic : candidate
logic -> candidate : findMember(nusId)
candidate --> logic : member
logic -> candidate : findOpenLoansForMember(nusId)
candidate --> logic : empty list
logic -> candidate : deleteMember(member)
note over candidate : Soft deletion preserves identity and history.
logic -> candidate : recordAddressBook(previous, "member delete")
note over logic, live : previous = live.getAddressBook()
logic -> storage : saveAddressBook(candidate.getAddressBook())
activate storage
storage -> storage : Serialize and replace the file atomically
storage --> logic : saved
deactivate storage
logic -> live : publishTransaction(candidate)
note over live : Existing observable root is retained.
logic --> ui : CommandResult with DisplayRequest.members()
deactivate logic
ui --> user : Feedback and refreshed Members directory
deactivate ui
legend bottom
  Component-level view: Logic delegates model calls to MemberDeleteCommand.
  Parse, validation or save failure prevents publication to the live model.
endlegend
@enduml
