<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<HBox spacing="12" alignment="CENTER_LEFT" styleClass="laplace-feedback,laplace-success"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <Label fx:id="feedbackStatus" text="Ready" minWidth="55" />
  <TextArea fx:id="resultDisplay" editable="false" wrapText="true" HBox.hgrow="ALWAYS" prefRowCount="2"
            minHeight="0" accessibleText="Command feedback" />
</HBox>
