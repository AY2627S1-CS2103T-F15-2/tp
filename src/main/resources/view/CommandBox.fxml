<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox styleClass="laplace-command" spacing="6" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <HBox spacing="8" alignment="CENTER_LEFT">
    <TextField fx:id="commandTextField" onAction="#handleCommandEntered" HBox.hgrow="ALWAYS"
               accessibleText="Command" promptText="Enter your command here" />
    <Button text="Enter" onAction="#handleCommandEntered" styleClass="command-key"
            accessibleText="Press Enter to execute">
      <tooltip><Tooltip text="Execute the command" /></tooltip>
    </Button>
  </HBox>
</VBox>
