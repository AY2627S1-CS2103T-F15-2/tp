<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fitToWidth="true" minWidth="0" minHeight="0"
            styleClass="laplace-surface,directory-summary" stylesheets="@DirectorySummary.css">
    <content>
        <VBox spacing="20" fillWidth="true" minWidth="0">
            <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Equipment Directory" styleClass="laplace-title" wrapText="true" minWidth="0" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="countBadge" styleClass="laplace-count-badge" />
            </HBox>
            <VBox spacing="16" styleClass="laplace-surface,directory-summary-box">
                <Label text="LIST SUMMARY" styleClass="laplace-muted" />
                <Label fx:id="criteria" wrapText="true" minWidth="0" />
                <GridPane hgap="12" vgap="14" minWidth="0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="38" minWidth="0" />
                        <ColumnConstraints percentWidth="62" minWidth="0" hgrow="ALWAYS" />
                    </columnConstraints>
                <Label text="Total items" styleClass="directory-key" wrapText="true" minWidth="0"
                       GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <Label fx:id="totalCount" text="" wrapText="true" minWidth="0" maxWidth="Infinity"
                       GridPane.rowIndex="0" GridPane.columnIndex="1" />
                <Label text="Displayed" styleClass="directory-key" wrapText="true" minWidth="0"
                       GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <Label fx:id="displayedCount" text="" wrapText="true" minWidth="0" maxWidth="Infinity"
                       GridPane.rowIndex="1" GridPane.columnIndex="1" />
                <Label text="Available" styleClass="directory-key" wrapText="true" minWidth="0"
                       GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <Label fx:id="availableCount" text="" wrapText="true" minWidth="0" maxWidth="Infinity"
                       GridPane.rowIndex="2" GridPane.columnIndex="1" />
                <Label text="Assigned" styleClass="directory-key" wrapText="true" minWidth="0"
                       GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <Label fx:id="assignedCount" text="" wrapText="true" minWidth="0" maxWidth="Infinity"
                       GridPane.rowIndex="3" GridPane.columnIndex="1" />
                <Label text="Unavailable" styleClass="directory-key" wrapText="true" minWidth="0"
                       GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <Label fx:id="unavailableCount" text="" wrapText="true" minWidth="0" maxWidth="Infinity"
                       GridPane.rowIndex="4" GridPane.columnIndex="1" />
                <Label text="Sort order" styleClass="directory-key" wrapText="true" minWidth="0"
                       GridPane.rowIndex="5" GridPane.columnIndex="0" />
                <Label fx:id="sortOrder" text="Category, name, then UUID" wrapText="true" minWidth="0" maxWidth="Infinity"
                       GridPane.rowIndex="5" GridPane.columnIndex="1" />
                <Label text="Selection" styleClass="directory-key" wrapText="true" minWidth="0"
                       GridPane.rowIndex="6" GridPane.columnIndex="0" />
                <Label fx:id="selection" text="" wrapText="true" minWidth="0" maxWidth="Infinity"
                       GridPane.rowIndex="6" GridPane.columnIndex="1" />
                </GridPane>
                <Label text="INVENTORY BY CATEGORY / TYPE (ALL ITEMS)" styleClass="laplace-muted"
                       wrapText="true" minWidth="0" />
                <Label fx:id="inventoryGroups" wrapText="true" minWidth="0" maxWidth="Infinity" />
            </VBox>
            <VBox fx:id="status" spacing="6" styleClass="laplace-success">
                <Label fx:id="statusTitle" styleClass="directory-status-title" wrapText="true" minWidth="0" />
                <Label fx:id="statusMessage" styleClass="laplace-muted" wrapText="true" minWidth="0"
                       maxWidth="Infinity" />
            </VBox>
        </VBox>
    </content>
</ScrollPane>
