@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR
hide empty members

class AddressBookParser
interface Parser <<interface>>
class MemberCommandParser
class MemberDeleteCommandParser
class LaplaceArgumentParser
class ParserUtil
class CliSyntax
class Prefix
class ArgumentMultimap
abstract class Command
class MemberDeleteCommand

AddressBookParser ..> MemberCommandParser : <<create>>
MemberCommandParser ..|> Parser
MemberDeleteCommandParser ..|> Parser
MemberCommandParser ..> MemberDeleteCommandParser : <<create>>
MemberDeleteCommandParser ..> MemberDeleteCommand : <<create>>
MemberDeleteCommand -up-|> Command
AddressBookParser ..> Command : returns
MemberDeleteCommandParser ..> LaplaceArgumentParser : validates arguments
MemberDeleteCommandParser ..> ParserUtil : parseNusId
MemberDeleteCommandParser ..> CliSyntax : PREFIX_NUS_ID
CliSyntax ..> Prefix
LaplaceArgumentParser ..> Prefix
LaplaceArgumentParser ..> ArgumentMultimap : <<create>>
MemberDeleteCommandParser ..> ArgumentMultimap : reads values

legend bottom
  Focus: member delete; other family, leaf and utility parsers are omitted.
  MemberCommandParser implements Parser<Command>.
  MemberDeleteCommandParser implements Parser<MemberDeleteCommand>.
  AddressBookParser uses parseCommand() and does not implement Parser<T>.
endlegend
@enduml
