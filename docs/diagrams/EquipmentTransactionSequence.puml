@startuml
skinparam shadowing false
skinparam defaultFontName Arial
hide footbox
skinparam maxMessageSize 150
<style>
participant {
  padding 10
}
</style>

participant ":LogicManager" as logic
participant "live:ModelManager" as live
participant "add:EquipmentAddCommand" as command
participant "candidate:ModelManager" as candidate
participant ":StorageManager" as storage

note over logic, command
  Parsing has returned command; command.isTransactional() is true.
end note
activate logic
logic -> live : createTransactionSnapshot()
activate live
create candidate
live -> candidate : ModelManager(data, prefs, history)
activate candidate
candidate --> live : candidate
deactivate candidate
live --> logic : candidate
deactivate live
note over live, candidate
  Copy records and preferences.
  Initially share only immutable session history.
end note
logic -> command : execute(candidate)
activate command
command -> command : prepareUnits(candidate)
activate command
note right of command
  Reserve all UUIDs before insertion.
  Check stored and in-batch identities.
  Up to 100 generation attempts per unit.
end note
command --> command : units
deactivate command
note right of command
  Compute duplicate-description warning
  once against the pre-insertion data.
end note
loop each prepared physical unit
  command -> candidate : addEquipment(unit)
  activate candidate
  note over command, candidate
    Delegates to root and equipment collection.
    Only the isolated candidate changes.
  end note
  candidate --> command : return
  deactivate candidate
end
command --> logic : result:CommandResult
deactivate command
logic -> command : recordsHistory()
command --> logic : true
logic -> live : getAddressBook()
live --> logic : previousData
logic -> candidate : recordAddressBook(previousData, "equipment add")
note right of candidate
  Stage one history entry for the whole batch.
  Clear redo only for a real record change.
  Retain at most 10 changes / 11 snapshots.
end note
candidate --> logic : return
logic -> candidate : getAddressBook()
candidate --> logic : candidateData
logic -> storage : saveAddressBook(candidateData)
note over candidate, storage
  JsonAddressBookStorage serializes first.
  AtomicFileWriter writes and flushes a sibling file,
  then atomically replaces the destination.
end note
alt save succeeds
  storage --> logic : return
  logic -> live : publishTransaction(candidate)
  activate live
  note over live, command
    resetData installs candidate records and adopts history
    before resuming collection notifications.
    Existing observable root/views remain in use.
  end note
  live --> logic : return
  deactivate live
  [<-- logic : result (including typed DisplayRequest)
else save throws IOException
  storage --> logic : IOException
  [<-- logic : CommandException with original cause
  note over logic, live
    No publication; live records, history and previous data file stay intact.
  end note
end
deactivate logic
@enduml
