@startuml
!include style.puml
skinparam ParticipantBackgroundColor UI_COLOR_T1
skinparam ParticipantFontColor #111111
skinparam maxMessageSize 180
title Read-only equipment browsing
participant ":LogicManager" as logic
participant ":EquipmentBrowseCommand" as browse
participant "model:Model" as model
participant "data:ReadOnlyAddressBook" as data
participant ":EquipmentViewCommand" as exact
participant ":MainWindow" as window
logic -> browse : execute(model)
activate browse
browse -> model : getAddressBook()
model --> browse : data
browse -> data : getEquipmentList()
data --> browse : retained units
alt group form and exact normalized category/name exists
  note right of browse
    Prepare CommandResult with equipmentGroup(key).
  end note
else compact UUID form and exactly one retained unit matches
  create exact
  browse -> exact : EquipmentViewCommand(uuid)
  activate exact
  exact --> browse : new command
  deactivate exact
  browse -> exact : execute(model)
  activate exact
  ref over exact, model
    Resolve UUID, availability and current holder
  end ref
  exact --> browse : CommandResult with equipmentDetails(uuid)
  deactivate exact
else missing group / missing or ambiguous compact reference
  note right of browse
    Reject the target with CommandException.
  end note
end
browse --> logic : result, or throws CommandException
deactivate browse
opt command succeeds
  logic --> window : result
  window -> window : display typed request and retain query
end
note over browse, data
  No record mutation, saving or history entry.
  Compact-reference collisions include deleted and filtered units.
end note
@enduml
