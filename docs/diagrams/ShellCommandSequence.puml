@startuml
!include style.puml
skinparam ParticipantBackgroundColor UI_COLOR_T1
skinparam ParticipantFontColor #111111
skinparam sequenceMessageAlign left
skinparam maxMessageSize 220
title One execution path for typed commands and identity links

actor User as user
participant "input:CommandBox" as input
participant "window:MainWindow" as window
participant "logic:Logic" as logic
participant "feedback:ResultDisplay" as feedback

alt nonblank command submitted with Enter
  user -> input : submit command text
  input -> window : executeCommand(text) via CommandExecutor
else explicit member / equipment identity activation
  user -> window : activate("member view nus/..."\nor "equipment view uuid/...") via panel callback
  window -> window : executeCommand(text)
end
activate window
window -> logic : execute(text)
activate logic
ref over logic
  Parsing and execution; transactional mutations use
  MutationTransactionSequence; isReadOnly() bypasses saving
end ref
logic --> window : result or ParseException / CommandException
deactivate logic
alt execution succeeds
  window -> window : applyAppearance()
  window -> feedback : setFeedbackToUser(result.getFeedbackToUser())
  window -> window : refreshViews()
  alt result requests Help
    window -> window : handleHelp()
  else result requests Exit
    window -> window : handleExit()
  else ordinary display result
    window -> window : display(result.getDisplayRequest())
  end
  opt submitted through CommandBox
    window --> input : result
    input -> input : clear text; requestFocus()
  end
else ParseException or CommandException
  window -> feedback : setFeedbackToUser(message, true)
  window -> window : queueRefresh()
  alt submitted through CommandBox
    window --> input : rethrow original exception
    input -> input : retain text; mark error; requestFocus()
  else explicit panel activation
    window -> window : activate catches exception;\nrequest correction focus after Space release if needed
  end
end
deactivate window
note over input, window
  Navigation tabs and equipment group selection display views directly.
  Copy / Use command previews only copy or prepare text, without execution.
end note
@enduml
