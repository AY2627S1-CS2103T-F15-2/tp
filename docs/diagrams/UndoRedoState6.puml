@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam objectAttributeIconSize 0
skinparam objectBackgroundColor #F6F8FA
skinparam objectBorderColor #59636E
skinparam ArrowColor #59636E
hide empty members

title After redo: restore the recorded edit

object "<u>h4:AddressBookHistory</u>" as history {
  position = 2
  states = [s0, s1, s2]
  descriptions = [equipment add, equipment edit]
}

object "<u>s0:AddressBook</u>" as s0 {
  Equipment: none
}

object "<u>s1:AddressBook</u>" as s1 {
  uuid = u
  name = Camera
  condition = GOOD
}

object "<u>s2:AddressBook</u>" as s2 #DDF4FF {
  uuid = u
  name = Camera
  condition = FAIR
}
s0 -[hidden]right-> s1
s1 -[hidden]right-> s2

history ..> s2 : states[position]

note bottom of history
  Redo restores s2 with the original UUID and details.
  It does not execute equipment edit again.
end note

legend bottom
  Each sN is a complete stored record snapshot; unrelated records are omitted from its label.
  The highlighted snapshot matches live record values after saving and publication.
  The live observable AddressBook remains a separate object.
endlegend
@enduml
