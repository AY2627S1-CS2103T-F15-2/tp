@startuml
!include style.puml
skinparam ArrowFontStyle plain
participant ":LogicManager" as logic LOGIC_COLOR
participant ":AddressBookParser" as root LOGIC_COLOR
participant ":MemberCommandParser" as family LOGIC_COLOR
participant ":MemberDeleteCommandParser" as leaf LOGIC_COLOR
participant "d:MemberDeleteCommand" as command LOGIC_COLOR
participant "live:Model" as live MODEL_COLOR
participant "candidate:Model" as candidate MODEL_COLOR
participant ":Storage" as storage STORAGE_COLOR

title Successful member delete: parsing, execution and publication
[-> logic : execute("member delete nus/A0123456X")
activate logic
logic -> root : parseCommand("member delete nus/A0123456X")
activate root
root -> family : parse("delete nus/A0123456X")
activate family
family -> leaf : parse("nus/A0123456X")
activate leaf
note over leaf
  LaplaceArgumentParser validates required nus/.
  ParserUtil.parseNusId produces the normalized identity.
end note
create command
leaf -> command : MemberDeleteCommand(nusId)
leaf --> family : d
deactivate leaf
family --> root : d
deactivate family
root --> logic : d
deactivate root
logic -> command : isTransactional()
command --> logic : true
logic -> live : createTransactionSnapshot()
create candidate
live -> candidate : ModelManager(records, prefs, history)
live --> logic : candidate
logic -> command : execute(candidate)
activate command
command -> candidate : findMember(nusId)
candidate --> command : member
command -> candidate : findOpenLoansForMember(nusId)
candidate --> command : empty list
command -> candidate : deleteMember(member)
note over candidate : Active member is soft-deleted; open loans would block deletion.
command --> logic : result:CommandResult (DisplayRequest.members())
deactivate command
logic -> command : isReadOnly()
command --> logic : false
logic -> command : recordsHistory()
command --> logic : true
logic -> candidate : recordAddressBook(previous, "member delete")
logic -> storage : saveAddressBook(candidate.getAddressBook())
storage --> logic : saved atomically
logic -> live : publishTransaction(candidate)
[<-- logic : result
deactivate logic
legend bottom
  Successful path only; previous = live.getAddressBook().
  Family and leaf parser construction and incidental whitespace are omitted.
  Invalid input, missing/deleted members, open loans or save failure leave live data unchanged.
endlegend
@enduml
