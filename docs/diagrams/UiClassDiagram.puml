@startuml
!include style.puml
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR
hide empty members

package "UI (supported views)" {
  interface Ui
  class UiManager
  class MainWindow
  class CommandBox
  class ResultDisplay
  class MemberListPanel
  class MemberDetailsPanel
  class EquipmentListPanel
  class EquipmentGroupPanel
  class EquipmentDetailsPanel
  class LoanPanel
  class HelpWindow
  class CommandPreview
}
interface Logic
interface ReadOnlyAddressBook
class DisplayRequest <<immutable>>
class "InventoryGroups.Group" as Group <<derived>>
class GuiSettings <<immutable>>

UiManager ..|> Ui
UiManager --> "1" MainWindow
MainWindow *--> "1" CommandBox
MainWindow *--> "1" ResultDisplay
MainWindow *--> "1" MemberListPanel
MainWindow *--> "1" MemberDetailsPanel
MainWindow *--> "1" EquipmentListPanel
MainWindow *--> "1" EquipmentGroupPanel
MainWindow *--> "1" LoanPanel
MainWindow *--> "1" HelpWindow
EquipmentGroupPanel *--> "1" EquipmentDetailsPanel
EquipmentDetailsPanel ..> CommandPreview
MemberDetailsPanel ..> CommandPreview
HelpWindow ..> CommandPreview
EquipmentListPanel ..> Group
MainWindow --> Logic
MainWindow --> ReadOnlyAddressBook
MainWindow ..> DisplayRequest
MainWindow ..> GuiSettings

note bottom of EquipmentGroupPanel
  Derived group + physical-unit table.
  Explicit unit selection retains its UUID.
end note
note bottom of CommandPreview
  Copy or prepare only.
  Execution stays in CommandBox → MainWindow → Logic.
end note
legend bottom
  Focused ownership and dependency view.
  UiPart inheritance, directory summaries, footer and
  internal legacy compatibility panel are omitted.
endlegend
@enduml
