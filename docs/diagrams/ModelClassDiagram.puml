@startuml
!include style.puml
skinparam classAttributeFontColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam linetype ortho

title Member model: immutable details and retained deletion state

package Model as ModelPackage {
    class Model <<interface>> {
        +setMember(target: Member, editedMember: Member): void
        +deleteMember(member: Member): void
        +restoreMember(member: Member): void
    }
    class ReadOnlyAddressBook <<interface>>
    class ReadOnlyUserPrefs <<interface>>
    class ModelManager
    class UserPrefs
    class AddressBook {
        +setMember(target: Member, editedMember: Member): void
        +removeMember(member: Member): void
        +restoreMember(member: Member): void
    }
    class UniqueMemberList {
        +setMember(target: Member, editedMember: Member): void
        +setDeleted(nusId: NusId, isDeleted: boolean): void
    }
    class Member {
        -deleted: boolean {readOnly}
        +isDeleted(): boolean
        +isSameMember(otherMember: Member): boolean
    }
    class NusId
    class Name
    class Phone
    class Email
}
show Model methods
show AddressBook methods
show UniqueMemberList methods
show Member members

ModelManager ..|> Model
ModelManager --> "1" AddressBook
ModelManager --> "1" UserPrefs
AddressBook ..|> ReadOnlyAddressBook
UserPrefs ..|> ReadOnlyUserPrefs
Model ..> ReadOnlyAddressBook
Model ..> ReadOnlyUserPrefs
AddressBook --> "0..1\n-members" UniqueMemberList
UniqueMemberList --> "0..*" Member
Member --> "1\n-nusId" NusId
Member --> "1\n-name" Name
Member --> "1\n-phone" Phone
Member --> "1\n-email" Email

note right of UniqueMemberList
  Includes active and deleted members.
  Replacements retain identity and list position.
  Edits cannot change deletion state.
  Deleted members must be restored before editing.
end note
note bottom of Member
  Member instances are immutable.
  The four named association ends are read-only.
  Four-field constructor defaults deleted to false.
  Five-field constructor accepts deletion state.
  Equality and hashing include deleted;
  isSameMember compares only the NUS ID.
end note
note left of AddressBook
  Member-focused view: equipment, loans and
  legacy Person collections are omitted.
  Member storage is initialized lazily.
  Closed loan history and deleted IDs are retained.
end note
@enduml
