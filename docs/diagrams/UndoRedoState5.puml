@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam objectAttributeIconSize 0
skinparam objectBackgroundColor #F6F8FA
skinparam objectBorderColor #59636E
skinparam ArrowColor #59636E
hide empty members

title After a new edit following undo: discard the redo branch

object "<u>h6:AddressBookHistory</u>" as history {
  position = 2
  states = [s0, s1, s3]
  descriptions = [equipment add, equipment edit]
}

object "<u>s0:AddressBook</u>" as s0 {
  Equipment: none
}

object "<u>s1:AddressBook</u>" as s1 {
  uuid = u
  name = Camera
  condition = GOOD
}

object "<u>s3:AddressBook</u>" as s3 #DDF4FF {
  uuid = u
  name = Camera
  condition = DAMAGED
}
s0 -[hidden]right-> s1
s1 -[hidden]right-> s3

history ..> s3 : states[position]

note bottom of history
  Start from s1 again, then set condition/DAMAGED.
  The old redo state s2 is absent from the new history.
  Redo is no longer available.
end note

legend bottom
  Each sN is a complete stored record snapshot; unrelated records are omitted from its label.
  The highlighted snapshot matches live record values after saving and publication.
  The live observable AddressBook remains a separate object.
endlegend
@enduml
