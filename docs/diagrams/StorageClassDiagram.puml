@startuml
!include style.puml
skinparam classAttributeFontColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR

title Member deletion state in the JSON snapshot

package Storage as StoragePackage {
    interface Storage
    class StorageManager
    class JsonUserPrefsStorage
    class JsonAddressBookStorage
    class JsonSerializableAddressBook
    class JsonAdaptedMember {
        -nusId: String {readOnly}
        -name: String {readOnly}
        -phone: String {readOnly}
        -email: String {readOnly}
        -deleted: boolean
        ~setDeleted(value: JsonNode)
        +toModelType(): Member
    }
    class JsonAdaptedEquipment
    class JsonAdaptedLoan
    class JsonAdaptedPerson
    class JsonAdaptedTag
}
class Member <<immutable>> MODEL_COLOR
show JsonAdaptedMember members

StorageManager ..|> Storage
StorageManager --> "1" JsonUserPrefsStorage
StorageManager --> "1" JsonAddressBookStorage
JsonAddressBookStorage ..> JsonSerializableAddressBook
JsonSerializableAddressBook --> "0..*" JsonAdaptedMember : members
JsonSerializableAddressBook --> "0..*" JsonAdaptedEquipment : equipment
JsonSerializableAddressBook --> "0..*" JsonAdaptedLoan : loans
JsonSerializableAddressBook --> "0..*" JsonAdaptedPerson : persons (legacy)
JsonAdaptedPerson --> "0..*" JsonAdaptedTag
JsonAdaptedMember ..> Member : reconstructs with deletion flag

note right of JsonAdaptedMember
  Persist deleted as a JSON boolean.
  Missing legacy field defaults to false.
  Explicit null and non-boolean values are rejected.
end note
note bottom of JsonSerializableAddressBook
  Retain active and deleted members and closed loans.
  Validate entities before loading loan references.
  Closed loans may reference deleted members;
  open loans may not.
end note
@enduml
